# ─────────────────────────────────────────────────────────────────────────────
# DSHub Graduation Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000
NODE_ENV=development
SERVER_URL=http://localhost:9000
FRONTEND_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dshub-graduation?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── File Uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_STRICT_MAX=3

# ── Analytics ─────────────────────────────────────────────────────────────────
CURRENT_COHORT=Cohort A 2026
ANALYTICS_STALE_MINUTES=60
ANALYTICS_CRON_SCHEDULE=0 * * * *

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Africa/Lagos

# ── Cloudinary (File Storage) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret